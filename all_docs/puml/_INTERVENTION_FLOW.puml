@startuml Intervention Service - Sequence Diagram

title Intervention Service - Edge Device Interaction Flow

actor "Edge Device\n(InterventionPoller)" as Edge
participant "API Endpoint\n(main.py)" as API
participant "Orchestrator\n(intervention.py)" as Orchestrator
database "Supabase\nDatabase" as DB
participant "Decision Engine\n(decision_engine.py)" as Decision
participant "Suggestion Engine\n(suggestion_engine.py)" as Suggestion
participant "InterventionRecordManager" as RecordManager

== Polling Phase ==

Edge -> Edge: Poll timer triggers\n(every 15 minutes)

== API Request ==

Edge -> API: POST /api/intervention/suggest\n{user_id: "uuid"}
activate API

API -> Orchestrator: process_suggestion_request(request)
activate Orchestrator

== Validation & Data Fetching ==

Orchestrator -> Orchestrator: validate_suggestion_request()\nValidate UUID format

alt Invalid user_id
    Orchestrator -> API: ValueError
    API -> Edge: HTTP 400 Bad Request
    deactivate Orchestrator
    deactivate API
else Valid user_id
    Orchestrator -> DB: get_latest_emotion_log(user_id)
    activate DB
    DB --> Orchestrator: emotion_log\n{emotion_label, confidence_score, timestamp}
    deactivate DB
    
    alt No emotion logs found
        Orchestrator -> API: ValueError("No emotion logs found")
        API -> Edge: HTTP 400 Bad Request
        deactivate Orchestrator
        deactivate API
    else Emotion logs found
        Orchestrator -> Orchestrator: Validate emotion_label\n(must be: Sad, Angry, Happy, Fear)
        
        group Parallel Database Queries
            Orchestrator -> DB: fetch_recent_emotion_logs(user_id, hours=48)
            activate DB
            DB --> Orchestrator: recent_emotion_logs[]
            deactivate DB
            
            Orchestrator -> DB: fetch_user_preferences(user_id)
            activate DB
            DB --> Orchestrator: user_preferences{}
            deactivate DB
            
            Orchestrator -> DB: get_time_since_last_activity(user_id)
            activate DB
            DB --> Orchestrator: time_since_last_activity_minutes
            deactivate DB
            
            Orchestrator -> DB: get_activity_counts(user_id, days=30)
            activate DB
            DB --> Orchestrator: activity_counts{}\n{journal: 15, gratitude: 8, ...}
            deactivate DB
        end
        
        note over Orchestrator, Decision: Decision Engine
        
        Orchestrator -> Decision: decide_trigger_intervention(\nemotion_label,\nconfidence_score,\ntime_since_last_activity_minutes)
        activate Decision
        
        Decision -> Decision: Check: emotion_label in\n['Sad', 'Angry', 'Fear']?
        
        Decision -> Decision: Check: confidence_score >= 0.70?
        
        Decision -> Decision: Check: time_since_last_activity\n> 60.0 minutes?
        
        Decision -> Decision: Calculate decision_confidence\n- If all conditions met: min(confidence, 0.95)\n- If low confidence: confidence * 0.5\n- If recent activity: 0.0\n- If positive emotion: 0.0
        
        Decision -> Decision: Generate reasoning string
        
        Decision --> Orchestrator: (trigger_intervention: bool,\nconfidence_score: float,\nreasoning: str)
        deactivate Decision
        
        note over Orchestrator, Suggestion: Suggestion Engine
        
        Orchestrator -> Suggestion: suggest_activities(\nemotion_label,\nuser_preferences,\nactivity_counts)
        activate Suggestion
        
        Suggestion -> Suggestion: Initialize base scores from\nEMOTION_ACTIVITY_WEIGHTS[emotion_label]\nExample: Sad → {journal: 0.9, meditation: 0.8, ...}
        
        Suggestion -> Suggestion: Apply user preference adjustments\n- Preferred: score × 1.2\n- Not preferred: score × 0.7
        
        Suggestion -> Suggestion: Group activities by frequency count\n(same count = same group)
        
        Suggestion -> Suggestion: Sort groups by count (descending)\nAssign frequency multipliers:\n- Group rank 1: ×1.3 (most frequent)\n- Group rank 2: ×1.2\n- Group rank 3: ×1.1\n- Group rank 4: ×1.05 (least frequent)
        
        Suggestion -> Suggestion: Apply frequency multipliers to scores
        
        Suggestion -> Suggestion: Normalize scores to 0.0-1.0 range\nnormalized = score / max_score
        
        Suggestion -> Suggestion: Sort activities by score (descending)
        
        Suggestion -> Suggestion: Assign ranks (1-4, where 1 is best)
        
        Suggestion -> Suggestion: Generate reasoning string
        
        Suggestion --> Orchestrator: (ranked_activities: List[Dict],\nreasoning: str)
        deactivate Suggestion
        
        note over Orchestrator: Build Response
        
        Orchestrator -> Orchestrator: Build SuggestionResponse\n- user_id\n- decision (DecisionResult)\n- suggestion (SuggestionResult)
        
        Orchestrator --> API: SuggestionResponse
        deactivate Orchestrator
        
        API --> Edge: HTTP 200 OK\n{decision: {...}, suggestion: {...}}
        deactivate API
        
        note over Edge, RecordManager: Edge Device Processing
        
        Edge -> Edge: Extract decision and suggestion\nfrom response
        
        Edge -> RecordManager: update_record(\ndecision,\nsuggestion,\nrequest_time,\nresponse_time)
        activate RecordManager
        
        RecordManager -> RecordManager: Save to\nintervention_record.json
        
        RecordManager --> Edge: Record saved
        deactivate RecordManager
        
        Edge -> Edge: Check trigger_intervention flag
        
        alt trigger_intervention == true
            Edge -> Edge: Store flag for next wake word\n(intervention will trigger)
        else trigger_intervention == false
            Edge -> Edge: No intervention needed
        end
        
        Edge -> Edge: Schedule next poll\n(in 15 minutes)
    end
end

== User Interaction Phase (Later) ==

note over Edge: On next wake word detection\nwhen intent == "unknown"

Edge -> RecordManager: Load intervention_record.json
activate RecordManager
RecordManager --> Edge: intervention_record
deactivate RecordManager

Edge -> Edge: Check decision.trigger_intervention

alt trigger_intervention == true
    Edge -> Edge: Route to ActivitySuggestionActivity
    Edge -> Edge: Present ranked activities to user\n(1-4 with smalltalk option)
else trigger_intervention == false
    Edge -> Edge: Continue normal flow
end

@enduml

