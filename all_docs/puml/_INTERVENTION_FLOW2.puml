@startuml Intervention Service - Activity Diagram

title Intervention Service - Edge Device Interaction Flow

start

partition "Edge Device - Polling Phase" {
    :Poll timer triggers\n(every 15 minutes);
    
    :Prepare API request\n{user_id: "uuid"};
    
    :POST /api/intervention/suggest;
}

partition "Cloud Service - API Layer" {
    :Receive request;
    
    :Extract user_id from request;
    
    :Call orchestrator.process_suggestion_request();
}

partition "Cloud Service - Orchestrator" {
    :Validate user_id format\n(must be valid UUID);
    
    if (user_id is valid UUID?) then (no)
        :Raise ValueError;
        :Return HTTP 400 Bad Request;
        stop
    else (yes)
    endif
    
    :Fetch latest emotion_log from database;
    
    if (emotion logs found?) then (no)
        :Raise ValueError("No emotion logs found");
        :Return HTTP 400 Bad Request;
        stop
    else (yes)
        :Extract emotion_label, confidence_score, timestamp;
        
        :Validate emotion_label\n(must be: Sad, Angry, Happy, Fear);
        
        if (emotion_label is valid?) then (no)
            :Raise ValueError("Invalid emotion_label");
            :Return HTTP 400 Bad Request;
            stop
        else (yes)
        endif
        
        note right: Parallel Database Queries
        
        fork
            :Fetch recent emotion_logs\n(last 48 hours);
        fork again
            :Fetch user preferences\nfrom users table;
        fork again
            :Calculate time since last activity\nfrom intervention_log;
        fork again
            :Get activity counts\n(last 30 days);
        end fork
        
        :All database queries completed;
    endif
}

partition "Decision Engine Algorithm" {
    :Get emotion_label, confidence_score,\ntime_since_last_activity_minutes;
    
    :Check: emotion_label in\n['Sad', 'Angry', 'Fear']?;
    
    if (is negative emotion?) then (no)
        :Set is_negative_emotion = false;
    else (yes)
        :Set is_negative_emotion = true;
    endif
    
    :Check: confidence_score >= 0.70?;
    
    if (meets confidence threshold?) then (yes)
        :Set meets_confidence_threshold = true;
    else (no)
        :Set meets_confidence_threshold = false;
    endif
    
    :Check: time_since_last_activity > 60.0 minutes?;
    
    if (enough time passed?) then (yes)
        :Set enough_time_passed = true;
    else (no)
        :Set enough_time_passed = false;
    endif
    
    :Calculate: should_trigger =\nis_negative_emotion AND\nmeets_confidence_threshold AND\nenough_time_passed;
    
    if (should_trigger?) then (yes)
        :Calculate decision_confidence =\nmin(confidence_score, 0.95);
        :Generate reasoning:\n"Negative emotion detected,\nConfidence >= threshold,\nTime since last activity";
    else (no)
        if (not is_negative_emotion?) then (yes)
            :Set decision_confidence = 0.0;
            :Generate reasoning:\n"Emotion is not negative";
        else (no)
            if (not meets_confidence_threshold?) then (yes)
                :Calculate decision_confidence =\nconfidence_score * 0.5;
                :Generate reasoning:\n"Confidence < threshold";
            else (no)
                if (not enough_time_passed?) then (yes)
                    :Set decision_confidence = 0.0;
                    :Generate reasoning:\n"Recent activity detected";
                else (no)
                endif
            endif
        endif
    endif
    
    :Return (trigger_intervention, confidence, reasoning);
}

partition "Suggestion Engine Algorithm" {
    :Get emotion_label, user_preferences, activity_counts;
    
    :Initialize base scores from\nEMOTION_ACTIVITY_WEIGHTS[emotion_label];
    note right: Example: Sad →\n{journal: 0.9, meditation: 0.8,\ngratitude: 0.7, quote: 0.6}
    
    :Initialize activity_scores dictionary;
    
    :Loop through user_preferences;
    
    repeat
        :Get next preference (pref_key, pref_value);
        
        :Map pref_key to activity_type\n(journaling → journal, etc.);
        
        if (activity_type found in scores?) then (yes)
            if (pref_value is true?) then (yes)
                :Apply preferred multiplier:\nscore × 1.2;
            else (no)
                :Apply not_preferred multiplier:\nscore × 0.7;
            endif
        else (no)
        endif
    repeat while (More preferences to process?) is (yes)
    
    :Get activity counts for all types\n(default to 0 if missing);
    
    :Group activities by frequency count\n(same count = same group);
    
    repeat
        :Process next activity;
        :Add to frequency_groups[count];
    repeat while (More activities to group?) is (yes)
    
    :Sort frequency groups by count\n(descending order);
    
    :Initialize group_rank = 1;
    
    repeat
        :Get next group (group_count, activities_list);
        
        :Get frequency_multiplier for group_rank\n(1.3, 1.2, 1.1, or 1.05);
        
        :Loop through activities in group;
        
        repeat
            :Get next activity_type in group;
            :Apply multiplier to activity_scores[activity_type];
        repeat while (More activities in group?) is (yes)
        
        :Increment group_rank;
    repeat while (More groups to process?) is (yes)
    
    :Find max_score from all activity_scores;
    
    if (max_score > 0?) then (yes)
        :Normalize all scores:\nnormalized = score / max_score;
    else (no)
        :Keep scores as is;
    endif
    
    :Sort activities by score\n(descending order);
    
    :Initialize rank = 1;
    
    repeat
        :Get next (activity_type, score) from sorted list;
        :Create ranked_activity:\n{activity_type, rank, score};
        :Add to ranked_activities list;
        :Increment rank;
    repeat while (More activities to rank?) is (yes)
    
    :Generate reasoning string:\n"Emotion: {emotion_label};\nTop suggestion: {top_activity}";
    
    :Return (ranked_activities, reasoning);
}

partition "Cloud Service - Response Building" {
    :Build DecisionResult:\n{trigger_intervention, confidence_score, reasoning};
    
    :Build SuggestionResult:\n{ranked_activities, reasoning};
    
    :Build SuggestionResponse:\n{user_id, decision, suggestion};
    
    :Return HTTP 200 OK\nwith SuggestionResponse;
}

partition "Edge Device - Processing Response" {
    :Receive response from cloud service;
    
    if (response received successfully?) then (no)
        :Log error;
        :Schedule next poll\n(in 15 minutes);
        stop
    else (yes)
        :Extract decision and suggestion\nfrom response;
        
        :Save to intervention_record.json\nvia InterventionRecordManager;
        
        :Check decision.trigger_intervention flag;
        
        if (trigger_intervention == true?) then (yes)
            :Store flag for next wake word\n(intervention will trigger);
        else (no)
            :No intervention needed;
        endif
        
        :Schedule next poll\n(in 15 minutes);
    endif
}

partition "Edge Device - User Interaction Phase" {
    :Wait for wake word detection;
    
    repeat
        :Monitor for wake word;
    repeat while (Wake word detected?) is (no)
    
    :User speaks;
    
    :Speech-to-text processing;
    
    :Intent recognition;
    
    if (intent == "unknown"?) then (yes)
        :Load intervention_record.json;
        
        :Check decision.trigger_intervention;
        
        if (trigger_intervention == true?) then (yes)
            :Route to ActivitySuggestionActivity;
            
            :Load ranked activities from record;
            
            :Format and speak suggestions via TTS\n(Rank 1-4 with smalltalk option);
            
            :Listen for user's activity choice;
            
            if (Activity matched?) then (yes)
                :Route to selected activity\n(journal, meditation, gratitude, quote);
            else (no)
                :Route to SmallTalkActivity;
            endif
        else (no)
            :Continue normal flow\n(no intervention);
        endif
    else (no)
        :Route directly to requested activity\n(bypasses intervention);
    endif
}

stop

@enduml

